# Build artifacts
build/
build_*/
bin/
obj/
*.o
*.a
*.so
*.dylib

# Log files
*.log

# Test outputs
*_output.txt
test-results.xml
trace_*.txt
report.xml

# Binaries and executables
# NOTE: keep these patterns specific. Unanchored globs like "*_server" also
# match nested source directories (e.g. examples/zephyr_uds_server/), which
# silently drops newly added files from version control.
iso14229_server
*.exe

# Zephyr workspace and artifacts
zephyr-workspace/
examples/zephyr_uds_server/build/

# Local Python environment
.venv/
__pycache__/
*.pyc

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Local run artifacts (captures/logs/reports)
artifacts/*
!artifacts/README.md

# Documentation
ISO_14229-1_2013.en.PDF.pdf
build_quality/
.venv_zephyr/
zephyr-workspace-local/
zephyr-sdk-*.tar.xz
zephyr-sdk-*/

# Compiled test binaries
tests/unit/test_*
!tests/unit/test_*.c
!tests/unit/test_*.h
examples/client_demo/uds_client_demo


# Local issue-fetch scratch (never commit; may contain copyrighted specs)
.issue-context/
