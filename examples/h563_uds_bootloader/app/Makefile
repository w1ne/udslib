# Makefile — build App A, App B, and App B-bad demo payloads.
#
# Usage:
#   make APP=A          → app_a.elf, app_a.bin, app_a_image.bin
#   make APP=B          → app_b.elf, app_b.bin, app_b_image.bin
#   make APP=Bbad       → app_bbad.elf, app_bbad.bin, app_bbad_image.bin
#   make APP=Bsigbad    → app_bsigbad_image.bin (App B payload, CRC-good but
#                         signature TAMPERED → must FAIL authenticity verify)
#   make both           → builds A and B variants
#   make all-three      → builds A, B, and Bbad variants
#   make all-four       → builds A, B, Bbad, and Bsigbad variants
#   make image-verify   → host cross-check: validates app_b_image.bin via
#                         the bootloader's ota_crc.c + ota_image.h logic
#   make clean

APP ?= A

CC      := arm-none-eabi-gcc
OBJCOPY := arm-none-eabi-objcopy
PYTHON  := python3

BUILD_DIR := build

CPUFLAGS := -mcpu=cortex-m33 -mthumb

# STM32H5 vendor sources (CMSIS device header). boot_confirm.c reaches the
# FLASH registers through the ST CMSIS FLASH_TypeDef instead of hand-typed
# addresses. Located the same way the bootloader build locates them: under the
# udslib zephyr workspace, three levels up from this app dir.
UDSLIB_DIR ?= $(abspath $(CURDIR)/../../..)
ZEPHYR_WS  ?= $(UDSLIB_DIR)/zephyr-workspace
CUBE_DIR   ?= $(ZEPHYR_WS)/modules/hal/stm32/stm32cube/stm32h5xx
CMSIS_DIR  ?= $(ZEPHYR_WS)/modules/hal/cmsis_6/CMSIS/Core/Include
STM32_CFLAGS := -I$(CMSIS_DIR) -I$(CUBE_DIR)/soc -DSTM32H563xx

# APP_VARIANT mapping:
#   A    → 1 (App A, confirms)
#   B    → 2 (App B-good, confirms)
#   Bbad → 3 (App B-bad, does NOT confirm → triggers rollback demo)
# Bsigbad reuses App B's payload (APP_VARIANT=2) but mkimage tampers the
# signature so the image is CRC-good yet authenticity-bad.
MKIMAGE_FLAGS :=
ifeq ($(APP),A)
  APP_VARIANT_NUM := 1
  VERSION         := 0x00010000
else ifeq ($(APP),B)
  APP_VARIANT_NUM := 2
  VERSION         := 0x00020000
else ifeq ($(APP),Bbad)
  APP_VARIANT_NUM := 3
  VERSION         := 0x00020000
else ifeq ($(APP),Bsigbad)
  APP_VARIANT_NUM := 2
  VERSION         := 0x00020000
  MKIMAGE_FLAGS   := --tamper-signature
else
  $(error APP must be A, B, Bbad, or Bsigbad)
endif

CFLAGS := $(CPUFLAGS) \
          -Os -g \
          -ffreestanding \
          -ffunction-sections -fdata-sections \
          $(STM32_CFLAGS) \
          -Wall -Wextra -Werror \
          -DAPP_VARIANT=$(APP_VARIANT_NUM)

LDFLAGS := $(CPUFLAGS) \
           -ffreestanding \
           -nostdlib \
           -T app.ld \
           -Wl,--gc-sections

SRCS := startup.c main.c boot_confirm.c
OBJS := $(patsubst %.c,$(BUILD_DIR)/$(APP)/%.o,$(SRCS))

# Lowercase APP name for output file naming (A→a, B→b, Bbad→bbad).
APP_LOWER := $(shell echo $(APP) | tr A-Z a-z)

ELF   := $(BUILD_DIR)/app_$(APP_LOWER).elf
BIN   := $(BUILD_DIR)/app_$(APP_LOWER).bin
IMAGE := $(BUILD_DIR)/app_$(APP_LOWER)_image.bin

# Convenience aliases in the current directory (for easier testing).
ELF_LINK   := app_$(APP_LOWER).elf
BIN_LINK   := app_$(APP_LOWER).bin
IMAGE_LINK := app_$(APP_LOWER)_image.bin

.PHONY: all both all-three all-four image-verify clean

all: $(IMAGE_LINK)

both:
	$(MAKE) APP=A
	$(MAKE) APP=B

all-three:
	$(MAKE) APP=A
	$(MAKE) APP=B
	$(MAKE) APP=Bbad

all-four:
	$(MAKE) APP=A
	$(MAKE) APP=B
	$(MAKE) APP=Bbad
	$(MAKE) APP=Bsigbad

$(IMAGE_LINK): $(BIN_LINK)
	$(PYTHON) mkimage.py $< $@ --version $(VERSION) $(MKIMAGE_FLAGS)

$(BIN_LINK): $(ELF_LINK)
	$(OBJCOPY) -O binary $< $@

$(ELF_LINK): $(OBJS) app.ld
	$(CC) $(LDFLAGS) $(OBJS) -o $@

$(BUILD_DIR)/$(APP)/%.o: %.c | $(BUILD_DIR)/$(APP)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/$(APP):
	mkdir -p $@

# ---- host cross-check -------------------------------------------------------
# Compiles a tiny host validator using the bootloader's ota_crc.c + ota_image.h
# and verifies that app_b_image.bin passes magic + CRC + SP checks — i.e. the
# same test the bootloader's app_is_valid() would apply.
BOOTLOADER_DIR := ../bootloader
IMAGE_VERIFY_SRCS := image_verify.c $(BOOTLOADER_DIR)/ota_crc.c

image_verify.c:
	@printf '%s\n' \
	  '/* Auto-generated by app/Makefile image-verify target. */' \
	  '#include "$(BOOTLOADER_DIR)/ota_image.h"' \
	  '#include "$(BOOTLOADER_DIR)/ota_crc.h"' \
	  '#include <stdint.h>' \
	  '#include <stdio.h>' \
	  '#include <stdlib.h>' \
	  '#include <string.h>' \
	  '' \
	  '#define RAM_BASE 0x20000000UL' \
	  '#define RAM_END  0x200A0000UL' \
	  '' \
	  'static int verify(const char *path) {' \
	  '    FILE *f = fopen(path, "rb");' \
	  '    if (!f) { perror(path); return 1; }' \
	  '    fseek(f, 0, SEEK_END); long sz = ftell(f); rewind(f);' \
	  '    uint8_t *buf = malloc((size_t)sz);' \
	  '    if (!buf || fread(buf, 1, (size_t)sz, f) != (size_t)sz) {' \
	  '        fprintf(stderr, "read error\n"); fclose(f); return 1; }' \
	  '    fclose(f);' \
	  '    if (sz < OTA_IMAGE_HDR_SIZE) { fprintf(stderr,"FAIL: too short\n"); return 1; }' \
	  '    ota_image_header_t hdr; memcpy(&hdr, buf, sizeof(hdr));' \
	  '    if (hdr.magic != OTA_IMAGE_MAGIC) { fprintf(stderr,"FAIL: bad magic 0x%08X\n", hdr.magic); return 1; }' \
	  '    printf("PASS: magic=0x%08X\n", hdr.magic);' \
	  '    if (hdr.image_size == 0 || hdr.image_size > OTA_IMAGE_MAX_PAYLOAD) { fprintf(stderr,"FAIL: bad size\n"); return 1; }' \
	  '    printf("PASS: image_size=%u\n", hdr.image_size);' \
	  '    if ((long)(OTA_IMAGE_HDR_SIZE + hdr.image_size) > sz) { fprintf(stderr,"FAIL: buffer too small\n"); return 1; }' \
	  '    const uint8_t *payload = buf + OTA_IMAGE_HDR_SIZE;' \
	  '    uint32_t computed = ota_crc32(payload, hdr.image_size);' \
	  '    if (computed != hdr.crc32) { fprintf(stderr,"FAIL: CRC mismatch computed=0x%08X stored=0x%08X\n", computed, hdr.crc32); return 1; }' \
	  '    printf("PASS: CRC-32/ISO-HDLC=0x%08X\n", computed);' \
	  '    uint32_t sp; memcpy(&sp, payload, sizeof(sp));' \
	  '    if (sp < RAM_BASE || sp > RAM_END) { fprintf(stderr,"FAIL: initial SP=0x%08X outside RAM\n", sp); return 1; }' \
	  '    printf("PASS: initial SP=0x%08X (in RAM)\n", sp);' \
	  '    printf("PASS: version=0x%08X\n", hdr.version);' \
	  '    printf("PASS: app_b_image.bin is valid\n");' \
	  '    free(buf); return 0;' \
	  '}' \
	  '' \
	  'int main(void) { return verify("app_b_image.bin"); }' \
	  > image_verify.c

$(BUILD_DIR)/image_verify: image_verify.c $(BOOTLOADER_DIR)/ota_crc.c | $(BUILD_DIR)
	gcc -O2 -g -I$(BOOTLOADER_DIR) -Wall -Wextra -Werror \
	    image_verify.c $(BOOTLOADER_DIR)/ota_crc.c \
	    -o $@

$(BUILD_DIR):
	mkdir -p $@

image-verify: app_b_image.bin $(BUILD_DIR)/image_verify
	$(BUILD_DIR)/image_verify

clean:
	rm -rf $(BUILD_DIR) image_verify.c \
	       app_a.elf app_a.bin app_a_image.bin \
	       app_b.elf app_b.bin app_b_image.bin \
	       app_bbad.elf app_bbad.bin app_bbad_image.bin \
	       app_bsigbad.elf app_bsigbad.bin app_bsigbad_image.bin
